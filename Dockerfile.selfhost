# Multi-Stage Build for Standalone Self-Hosted BSD LiveChat Gateway
# Stage 1: Builder
FROM node:22-alpine AS builder

WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate

# Copy monorepo manifests and lockfile
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/widget/package.json ./packages/widget/
COPY packages/react/package.json ./packages/react/
COPY apps/gateway/package.json ./apps/gateway/

# Install all dependencies including devDependencies for compilation
RUN pnpm install --frozen-lockfile

# Copy source codes
COPY packages/sdk ./packages/sdk
COPY packages/widget ./packages/widget
COPY packages/react ./packages/react
COPY apps/gateway ./apps/gateway

# Compile monorepo packages
RUN pnpm run build

# Stage 2: Minimal Production Runtime
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3100
ENV HOST=0.0.0.0

# Install dumb-init for clean process signal handling
RUN apk add --no-cache dumb-init

# Use non-root node user
USER node

# Copy built artifacts and runtime packages
COPY --chown=node:node --from=builder /app/apps/gateway/dist ./apps/gateway/dist
COPY --chown=node:node --from=builder /app/packages/widget/dist ./packages/widget/dist
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/apps/gateway/node_modules ./apps/gateway/node_modules
COPY --chown=node:node --from=builder /app/package.json ./package.json

EXPOSE 3100

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/gateway/dist/server.cjs"]
