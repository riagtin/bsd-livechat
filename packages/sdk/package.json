{
  "name": "@bintangstudio/livechat-sdk",
  "version": "2.0.0",
  "description": "Shared SDK and type definitions for BSD LiveChat (Official Meta WhatsApp Cloud API Bridge)",
  "license": "MPL-2.0",
  "author": "PT. BINTANG STUDIO DIGITAL <support@bintangstudio.tech>",
  "homepage": "https://bintangstudio.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/bintangstudio/livechat.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
